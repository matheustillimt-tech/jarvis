# Copie este arquivo para .env e preencha.

# Pasta que o Claude Code abre (seu segundo cérebro, vault ou projeto)
JARVIS_PASTA=~/Documentos/meu-vault

# ElevenLabs: voz da resposta (e transcrição, se você não tiver whisper local)
ELEVENLABS_API_KEY=
# ID da voz. Escolha na Voice Library, clique em "Add to my voices" e copie o ID.
JARVIS_VOZ=xHUwLsLfyqiYOIVTzLRW
# eleven_multilingual_v2 = melhor som | eleven_flash_v2_5 = começa a falar mais rápido
JARVIS_MODELO_VOZ=eleven_multilingual_v2
# Velocidade da fala: 1.0 normal (de 0.7 a 1.2)
JARVIS_VELOCIDADE_VOZ=1.0

# Transcrição: auto (tenta o whisper local e cai pro ElevenLabs) | whisper | elevenlabs
JARVIS_TRANSCRICAO=auto
WHISPER_URL=http://127.0.0.1:8178

# Modelo do Claude: sonnet (mais rápido) | opus (mais caprichado)
JARVIS_MODELO=sonnet
# Quanto ele pensa antes de agir: low (mais rápido) | medium | high
JARVIS_ESFORCO=low

# Ferramentas que o JARVIS não pode usar (separadas por vírgula)
JARVIS_BLOQUEAR_FERRAMENTAS=

# Atalhos lentos que rodam quando ele abre (separe por ;). Ex.: isca_resumo.py --dia ontem
JARVIS_AQUECER_ATALHOS=

JARVIS_PORTA=8790
